# Secrets — never commit
backend/.env
backend/.env.local
frontend/.env.local

# Dependencies — install via setup.sh
frontend/node_modules/

# Build output
frontend/.next/
frontend/tsconfig.tsbuildinfo

# Go build artifacts
backend/bin/
backend/tmp/

# OS
.DS_Store
Thumbs.db

# Uploads (local only)
backend/uploads/products/
backend/uploads/*.jpg
backend/uploads/*.jpeg
backend/uploads/*.png
backend/uploads/*.webp
!backend/uploads/.gitkeep

# Python & AI Service
ai/.env
ai/.env.local
.venv/
*/.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

