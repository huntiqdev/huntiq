{
  "version": "2.0.0",
  "framework": "HUNTIQ Multi-Dimensional Marketplace Classification Framework",
  "governing_rule": "Taxonomy models intrinsic domain concepts (the WHAT). Orthogonal dimensions model engagement, transaction, condition, and fulfillment (the HOW).",
  "systems": [
    {
      "system_id": "SYS_PROD",
      "code": "A",
      "name": "Products & Physical Assets",
      "description": "Tangible goods, raw agricultural commodities, manufactured merchandise, machinery, vehicles, and physical real estate assets.",
      "transaction_modes": [
        "for_sale",
        "for_rent",
        "for_lease",
        "auction",
        "barter"
      ],
      "condition_dimension": [
        "new",
        "open_box",
        "refurbished",
        "used_like_new",
        "used_good",
        "used_fair"
      ],
      "fulfillment_modes": [
        "local_pickup",
        "courier_delivery",
        "freight_shipping"
      ],
      "root_family_count": 147,
      "example_roots": [
        "Field Crops & Cereal Grains",
        "Passenger Automobiles, Sedans & SUVs",
        "Residential Multi-Family Apartments & Condos"
      ]
    },
    {
      "system_id": "SYS_SRV",
      "code": "B",
      "name": "Services & Professional Service Offerings",
      "description": "Contractual business-to-business (B2B) and business-to-consumer (B2C) agency services, trades, repairs, and professional consultancy.",
      "engagement_modes": [
        "hourly_rate",
        "fixed_project_fee",
        "retainer",
        "custom_quote"
