        "full_time",
        "part_time",
        "permanent",
        "temporary",
        "internship",
        "apprenticeship"
      ],
      "work_arrangements": [
        "on_site",
        "hybrid",
        "remote"
      ],
      "experience_levels": [
        "entry_level",
        "mid_level",
