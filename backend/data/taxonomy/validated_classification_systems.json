      "delivery_modes": [
        "on_premise",
        "in_shop",
        "remote_digital"
      ],
      "root_family_count": 16,
      "example_roots": [
        "Legal Services & Regulatory Compliance",
        "Accounting, Tax Advisory & Financial Audit",
        "Architecture & Civil Engineering Services"
      ]
    },
    {
