      "governing_rule": "A promoted laptop remains categorized under SYS_PROD -> Laptops. The promotion is a metadata campaign dimension.",
      "root_family_count": 2,
      "example_roots": [
        "Commercial Retail Discount Promotions & Sales Events",
        "B2B Service Promotional Packages"
      ]
    }
