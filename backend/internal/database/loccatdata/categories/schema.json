{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huntiq.et/schemas/masterdata/category.schema.json",
  "title": "HUNTIQ Category Schema",
  "description": "Schema for multi-classification category taxonomy with 4-language support",
  "type": "object",
  "required": [
    "id",
    "slug",
    "names",
    "level",
    "classification_system_code",
    "is_active",
    "is_leaf"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Stable canonical integer category identifier"
    },
    "parent_id": {
      "type": ["integer", "null"],
      "description": "Parent category identifier in tree"
    },
    "parent_code": {
      "type": ["string", "null"],
      "description": "Parent category slug or stable code"
    },
    "classification_system_code": {
      "type": "string",
      "enum": ["SYS_PROD", "SYS_SRV", "SYS_EMP", "SYS_GIG", "SYS_MED", "SYS_OPP", "SYS_PRM"],
      "description": "Classification system assignment code"
    },
    "names": {
      "type": "object",
      "required": ["en", "am", "om", "ti"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "am": { "type": "string", "minLength": 1 },
        "om": { "type": "string", "minLength": 1 },
        "ti": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-_]+$",
      "description": "URL-safe unique category slug"
    },
    "description": {
      "type": ["string", "null"]
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "Depth in hierarchy (0=root/family, 1=pillar, 2=sub-pillar, 3=leaf item)"
    },
    "path": {
      "type": "string",
      "pattern": "^/([0-9]+/)+$",
      "description": "Materialized path for ancestor queries (e.g. /1/1378/1380/)"
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "icon": {
      "type": ["string", "null"],
      "description": "Lucide icon identifier or SVG token"
    },
    "image_url": {
      "type": ["string", "null"]
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_leaf": {
      "type": "boolean",
      "default": false
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "meta_title": {
      "type": ["string", "null"]
    },
    "meta_description": {
      "type": ["string", "null"]
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "redirects": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": false
}
