# ============================================================================
# HUNTIQ Backend — Environment Variables Reference
# ============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control. It is already in .gitignore.
# Generate secure keys with:
#   JWT_SECRET:      openssl rand -base64 48
#   OTP_ENCRYPT_KEY: openssl rand -base64 32
# ============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Use DATABASE_URL (single DSN) for hosted providers (Render, Neon, Railway, etc.)
# OR the individual DB_* variables for local development.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=CHANGE_ME_generate_strong_password
DB_NAME=huntiq_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ── Server ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_-base64_48

# REQUIRED — generate with: openssl rand -base64 32 (must decode to >= 32 bytes)
OTP_ENCRYPT_KEY=CHANGE_ME_generate_with_openssl_rand_-base64_32

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOW_ORIGIN=http://localhost:3000

# ── File Storage ─────────────────────────────────────────────────────────────
# Local path for uploads (development). Use persistent disk or object storage in production.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ── Admin Seed (used only by: go run ./cmd/seed) ─────────────────────────────
# Set before running the seed command. Do NOT store real credentials here.
SEED_ADMIN_PASSWORD=CHANGE_ME_16plus_chars_min
SEED_ADMIN_PHONE=CHANGE_ME
SEED_ADMIN_EMAIL=CHANGE_ME@your-domain.com
SEED_ADMIN_NAME=Super Admin

# ── AI Service Integration (HUNTIQ AI — independent Python/FastAPI service) ──
# Go communicates with the Python AI service via authenticated HTTP.
# AI is fully optional — if stopped, all marketplace functions remain operational.
#
# Provider strategy: "ollama" (local Qwen3 via Ollama), "python" (remote FastAPI),
#                    or "mock" (deterministic fallback, no external calls)
AI_PROVIDER=ollama

# Pre-shared secret authenticating Go → Python calls (must match HUNTIQ_AI_SECRET in ai/.env)
# Generate with: openssl rand -hex 32
AI_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Python AI service base URL (used when AI_PROVIDER=python)
AI_SERVICE_URL=http://127.0.0.1:8000

# Ollama daemon endpoint and model (used when AI_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=huntiq-assistant:latest

# ── Redis Cache (optional, gracefully degrades to in-memory cache) ────────────
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# ── Optional: SMS / Email Provider ───────────────────────────────────────────
# Set otp_gateway in platform_settings (admin panel) to "sms" or "email".
# Configure the chosen provider's credentials here when ready.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=
