{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huntiq.et/schemas/masterdata/location.schema.json",
  "title": "HUNTIQ Location Schema",
  "description": "Schema for authoritative Ethiopian geographic master data with 4-language support",
  "type": "object",
  "required": [
    "id",
    "code",
    "type",
    "names",
    "slug",
    "level",
    "is_active"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique stable integer identifier preserved from PostgreSQL"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$",
      "description": "Standardized administrative code (e.g. ET, ET-AA, AA-BO, ET-OR-ES)"
    },
    "parent_id": {
      "type": ["integer", "null"],
      "description": "Identifier of immediate parent administrative division"
    },
    "parent_code": {
      "type": ["string", "null"],
      "description": "Administrative code of immediate parent division"
    },
    "type": {
      "type": "string",
      "enum": ["country", "region", "city", "zone", "subcity", "woreda", "kebele", "special_woreda"],
      "description": "Standard administrative division level"
    },
    "names": {
      "type": "object",
      "required": ["en", "am", "om", "ti"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "am": { "type": "string", "minLength": 1 },
        "om": { "type": "string", "minLength": 1 },
        "ti": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL-safe unique slug"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "description": "Hierarchy depth from country root (0=country, 1=region/chartered city, 2=zone/subcity/city, 3=woreda)"
    },
    "path": {
      "type": "string",
      "pattern": "^/([0-9]+/)+$",
      "description": "Materialized path for hierarchical ancestor queries"
    },
    "display_order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_leaf": {
      "type": "boolean",
      "default": false
    },
    "is_deprecated": {
      "type": "boolean",
      "default": false
    },
    "replaced_by_id": {
      "type": ["integer", "null"]
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] },
        "bbox": {
          "type": ["object", "null"],
          "properties": {
            "min_lat": { "type": ["number", "null"] },
            "max_lat": { "type": ["number", "null"] },
            "min_lng": { "type": ["number", "null"] },
            "max_lng": { "type": ["number", "null"] }
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "source": {
      "type": "string",
      "default": "authoritative"
    },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "pending", "unverified"],
      "default": "verified"
    }
  },
  "additionalProperties": false
}

