# Copy this file to .env.local and fill in real values. NEVER commit .env.local to git.

# API base URL — used by the frontend to call the backend
NEXT_PUBLIC_API_URL=<your_api_base_url>/api   # e.g. https://your-api.onrender.com/api

# Backend hostname for Next.js image remotePatterns (host only, no protocol/path)
NEXT_PUBLIC_BACKEND_HOST=<your_api_hostname>  # e.g. your-api.onrender.com

# Backend URL for local dev proxy rewrites (next.config.js)
BACKEND_URL=http://localhost:8080
