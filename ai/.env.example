# ============================================================================
# HUNTIQ AI Service — Environment Variables Reference
# ============================================================================
# This service is independently deployable and does NOT share .env with Go.
# Copy to .env and fill in values before starting: cp .env.example .env
# ============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED — Must match AI_SECRET_KEY in backend/.env
# Go authenticates all requests to Python with this header: X-HUNTIQ-AI-SECRET
# Generate with: openssl rand -hex 32
HUNTIQ_AI_SECRET=CHANGE_ME_generate_with_openssl_rand_-hex_32

# ── Go Backend Integration ────────────────────────────────────────────────────
# Python calls Go's /internal/ai/tools/execute for marketplace data.
# Python MUST NOT have direct database access — all marketplace data flows through Go.
GO_BACKEND_URL=http://127.0.0.1:8080

# ── Ollama Local Model ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Base model for fine-tuning and inference (Qwen3 4B, CPU-compatible)
OLLAMA_BASE_MODEL=qwen3:4b

# Derived HUNTIQ assistant model name (created by ai/scripts/setup_local.sh)
OLLAMA_HUNTIQ_MODEL=huntiq-assistant:latest

# Request timeout in seconds for local CPU inference
AI_REQUEST_TIMEOUT=90.0

# Context window size in tokens
AI_CONTEXT_LENGTH=4096

# ── Language Support ──────────────────────────────────────────────────────────
# English (en), Amharic (am), Afaan Oromoo (om), Tigrinya (ti)
# These are the four supported marketplace languages.
