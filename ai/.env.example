# Ollama Daemon Endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local Model Storage Directory (inside sellbuy project repository)
OLLAMA_MODELS=/home/poven/GO PROJECT/sellbuy/ai/models/ollama

# Base model to use with Ollama
OLLAMA_BASE_MODEL=qwen3:4b

# Derived HUNTIQ assistant model name
OLLAMA_HUNTIQ_MODEL=huntiq-assistant:latest

# Request Timeout in seconds (for CPU inference)
AI_REQUEST_TIMEOUT=90.0

# Context window size in tokens
AI_CONTEXT_LENGTH=4096
