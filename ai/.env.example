# ==============================================================================
# HUNTIQ AI Service — Environment Configuration Template
# ==============================================================================
# SAFE PLACEHOLDER VALUES ONLY. NEVER COMMIT REAL CREDENTIALS.
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Service Binding (bind strictly to loopback/private interface)
HOST=127.0.0.1
PORT=8000

# Logging: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO
LOG_FORMAT=json

# Internal Service Authentication Pre-Shared Secret
# In production, generate a 64-character random string via: openssl rand -base64 48
HUNTIQ_AI_SECRET_KEY=dev_secret_change_in_production

# Security & Traffic Bounding
MAX_PAYLOAD_SIZE_BYTES=65536
REQUEST_TIMEOUT_SECONDS=5.0

# Model Artifacts Directory (relative or absolute path)
MODEL_DIR=./models
