{
  "": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUNTIQ_Source_Schema",
  "description": "Schema defining an external or internal raw data source before ingestion.",
  "type": "object",
  "required": [
    "source_id",
    "source_name",
    "provider",
    "license_type",
    "ingestion_date",
    "data_format",
    "languages"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "license_type": {
      "type": "string",
      "enum": [
        "open_data",
        "commercial_licensed",
        "internal_curated",
        "cc_by_4_0"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingestion_date": {
      "type": "string",
      "format": "date-time"
    },
    "data_format": {
      "type": "string",
      "enum": [
        "jsonl",
        "csv",
        "parquet",
        "json"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "en",
          "am",
          "or",
          "ti"
        ]
      }
    },
    "checksum_sha256": {
      "type": "string"
    }
  }
}