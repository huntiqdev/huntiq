{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUNTIQ_28_confidence_uncertainty_Schema",
  "description": "Formal JSON validation schema for HUNTIQ dataset module 28_confidence_uncertainty (Confidence and Uncertainty)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "ambiguous_input": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number"
    },
    "abstention_threshold": {
      "type": "number"
    },
    "should_abstain": {
      "type": "boolean"
    },
    "uncertainty_response": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "ambiguous_input",
    "confidence_score",
    "should_abstain",
    "uncertainty_response"
  ],
  "additionalProperties": false
}
