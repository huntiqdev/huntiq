{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUNTIQ_10_location_understanding_Schema",
  "description": "Formal JSON validation schema for HUNTIQ dataset module 10_location_understanding (Ethiopian Location Understanding)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "raw_location": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "am",
        "or",
        "ti"
      ]
    },
    "canonical_city": {
      "type": "string"
    },
    "subcity": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "transliteration_variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "raw_location",
    "locale",
    "canonical_city"
  ],
  "additionalProperties": false
}
