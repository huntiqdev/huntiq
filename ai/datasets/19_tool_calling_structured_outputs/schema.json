  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "user_intent": {
      "type": "string"
    },
    "tool_name": {
      "type": "string",
      "enum": [
        "search_marketplace_listings",
        "get_listing_details",
        "compare_listings",
        "get_marketplace_stats"
      ]
    },
    "arguments": {
      "type": "object"
    },
    "schema_valid": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "user_intent",
    "tool_name",
    "arguments",
    "schema_valid"
  ],
  "additionalProperties": false
}
