{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUNTIQ_29_service_failure_error_conversations_Schema",
  "description": "Formal JSON validation schema for HUNTIQ dataset module 29_service_failure_error_conversations (Service Failure and Error Conversations)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "error_condition": {
      "type": "string",
      "enum": [
        "api_timeout",
        "db_unavailable",
        "rate_limit_exceeded",
        "network_split"
      ]
    },
    "user_query": {
      "type": "string"
    },
    "graceful_response": {
      "type": "string"
    },
    "allow_retry": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "error_condition",
    "user_query",
    "graceful_response",
    "allow_retry"
  ],
  "additionalProperties": false
}
