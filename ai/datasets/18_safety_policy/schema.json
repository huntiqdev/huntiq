{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUNTIQ_18_safety_policy_Schema",
  "description": "Formal JSON validation schema for HUNTIQ dataset module 18_safety_policy (Safety, Security and Platform Policy)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "adversarial_prompt": {
      "type": "string"
    },
    "threat_category": {
      "type": "string",
      "enum": [
        "prompt_injection",
        "pii_leak",
        "prohibited_content",
        "auth_bypass",
        "data_poisoning"
      ]
    },
    "safe_refusal_response": {
      "type": "string"
    },
    "policy_violation_code": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "adversarial_prompt",
    "threat_category",
    "safe_refusal_response"
  ],
  "additionalProperties": false
}
