{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HUNTIQ_11_multi_intent_understanding_Schema",
  "description": "Formal JSON validation schema for HUNTIQ dataset module 11_multi_intent_understanding (Multi-Intent Understanding)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "compound_query": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "am",
        "or",
        "ti"
      ]
    },
    "sub_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category_name": {
            "type": "string"
          },
          "listing_type": {
            "type": "string"
          },
          "clause": {
            "type": "string"
          }
        },
        "required": [
          "category_name",
          "clause"
        ]
      }
    }
  },
  "required": [
    "id",
    "compound_query",
    "locale",
    "sub_intents"
  ],
  "additionalProperties": false
}
